<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mirs260x">
	<xacro:arg name="nodding" default="false"/>
	<xacro:arg name="wheel_radius" default="0.0665"/>
	<xacro:arg name="wheel_track" default="0.465"/>
	<xacro:arg name="wheel_mu_longitudinal" default="1.0"/>
	<xacro:arg name="wheel_mu_lateral" default="0.2"/>
	<xacro:arg name="caster_mu" default="0.001"/>
	<!-- Define robot constants -->
	<xacro:property name="base_length" value="0.379"/>
	<xacro:property name="base_width" value="0.545"/>
	<xacro:property name="base_height" value="0.178"/>
	<!-- Keep approximately the previous total robot mass after removing six drive wheels. -->
	<xacro:property name="base_mass" value="23.45"/>

	<xacro:property name="wheel_radius" value="${float('$(arg wheel_radius)')}"/>
	<xacro:property name="wheel_track" value="${float('$(arg wheel_track)')}"/>
	<xacro:property name="wheel_mu_longitudinal" value="${float('$(arg wheel_mu_longitudinal)')}"/>
	<xacro:property name="wheel_mu_lateral" value="${float('$(arg wheel_mu_lateral)')}"/>
	<xacro:property name="caster_mu" value="${float('$(arg caster_mu)')}"/>
	<xacro:property name="wheel_width" value="0.08"/>
	<xacro:property name="wheel_zgap" value="0.02"/>
	<xacro:property name="wheel_mass" value="1.425"/>
	<xacro:property name="caster_radius" value="${wheel_radius}"/>

	<xacro:property name="laser_zoff" value="0.06"/>
	<xacro:property name="laser_height" value="0.051"/>
	<xacro:property name="laser_radius" value="0.0278"/>


	<material name="black">
		<color rgba="0 0 0 1"/>
	</material>
	<material name="white">
		<color rgba="1 1 1 1"/>
	</material>
	<material name="red">
		<color rgba="1 0 0 1"/> 
	</material>

	<!--==============================================================
		base_footprint: MIRSの前後左右の回転を無視したときの位置（地面）
	==============================================================-->
	<link name="base_footprint"/>

	<!--==============================================================
		base_link: MIRS本体（コンテナ）
	==============================================================-->
	<link name="base_link">
		<visual>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
			<material name="white"/> 
			<origin xyz="0 0 0"/> 
		</visual>
		<collision>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="${base_mass}"/>
			<!-- Lump removed wheel mass into the chassis and lower its center of mass. -->
			<origin xyz="0 0 -0.06"/>
			<inertia
				ixx="${base_mass*(base_width*base_width+base_height*base_height)/12.0}"
				ixy="0" ixz="0"
				iyy="${base_mass*(base_length*base_length+base_height*base_height)/12.0}"
				iyz="0"
				izz="${base_mass*(base_length*base_length+base_width*base_width)/12.0}"/>
		</inertial>
	</link>

	<joint name="base_joint" type="fixed">
		<parent link="base_footprint"/>
		<child link="base_link"/>
		<origin xyz="0 0 ${((wheel_radius*2)+wheel_zgap+(base_height/2))}" rpy="0 0 0"/>
	</joint>
	<link name="imu_link">
		<inertial>
			<mass value="0.01"/>
			<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
	</inertial>
	</link>
	<joint name="base_to_imu" type="fixed">
		<parent link="base_link"/>
		<child link="imu_link"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
	</joint>

	<!-- 2輪差動。wheel_track は左右の駆動輪中心間距離。 -->
	<xacro:macro name="wheel" params="prefix y_reflect">
		<link name="${prefix}_wheel">
			<visual>
				<geometry>
					<cylinder length="${wheel_width}" radius="${wheel_radius}"/>
				</geometry>
				<material name="black"/>
				<origin rpy="${pi/2} 0 0"/>
			</visual>
			<collision>
				<geometry>
					<cylinder length="${wheel_width}" radius="${wheel_radius}"/>
				</geometry>
				<origin rpy="${pi/2} 0 0"/>
			</collision>
			<inertial>
				<mass value="${wheel_mass}"/>
				<!-- Solid cylinder with its spin axis along the link's Y axis. -->
				<inertia
					ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12.0}"
					ixy="0" ixz="0"
					iyy="${wheel_mass*wheel_radius*wheel_radius/2.0}"
					iyz="0"
					izz="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12.0}"/>
			</inertial>
		</link>
		<joint name="${prefix}_wheel_joint" type="continuous">
			<parent link="base_link"/>
			<child link="${prefix}_wheel"/>
			<origin xyz="0 ${y_reflect*wheel_track/2} ${-(wheel_radius+wheel_zgap+(base_height/2))}"/>
			<axis xyz="0 1 0"/> 
		</joint>
	</xacro:macro>

	<xacro:wheel prefix="left" y_reflect="1"/>
	<xacro:wheel prefix="right" y_reflect="-1"/>

	<!-- 前後の低摩擦支持球で、簡略化した車体を安定させる。 -->
	<xacro:macro name="caster" params="prefix x_position">
		<link name="${prefix}_caster">
			<visual>
				<geometry><sphere radius="${caster_radius}"/></geometry>
				<material name="black"/>
			</visual>
			<collision>
				<geometry><sphere radius="${caster_radius}"/></geometry>
			</collision>
			<inertial>
				<mass value="0.05"/>
				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
			</inertial>
		</link>
		<joint name="${prefix}_caster_joint" type="fixed">
			<parent link="base_link"/>
			<child link="${prefix}_caster"/>
			<origin xyz="${x_position} 0 ${-(wheel_radius+wheel_zgap+(base_height/2))}"/>
		</joint>
	</xacro:macro>
	<xacro:caster prefix="front" x_position="${base_length/2-caster_radius}"/>
	<xacro:caster prefix="rear" x_position="${-(base_length/2-caster_radius)}"/>

	<!--==============================================================
		laser：LIDAR のフレーム
	==============================================================-->
	<link name="laser">
		<visual>
			<geometry>
				<cylinder length="${laser_height}" radius="${laser_radius}"/>
			</geometry>
			<material name="red"/>
		</visual>
		<collision>
			<geometry>
				<cylinder length="${laser_height}" radius="${laser_radius}"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="0.1"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
		</inertial>
	</link>
	<xacro:unless value="$(arg nodding)">
		<joint name="laser_joint" type="fixed">
			<parent link="base_link"/>
			<child link="laser"/>
			<origin xyz="0 0 ${laser_zoff+base_height/2+laser_height/2}" rpy="0 0 0"/>
		</joint>
	</xacro:unless>
	<xacro:if value="$(arg nodding)">
		<!-- 実機と同じ回転軸・センサオフセット: 0.142 + 0.0325 = 0.1745 m -->
		<link name="servo_link"/>
		<joint name="base_to_servo" type="fixed">
			<parent link="base_link"/>
			<child link="servo_link"/>
			<origin xyz="0 0 0.142" rpy="0 0 0"/>
		</joint>
		<link name="nodding_link">
			<inertial>
				<mass value="0.05"/>
				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
			</inertial>
		</link>
		<joint name="nodding_joint" type="revolute">
			<parent link="servo_link"/>
			<child link="nodding_link"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<axis xyz="0 1 0"/>
			<limit lower="-0.349066" upper="0.349066" effort="10" velocity="1.5"/>
			<dynamics damping="0.1"/>
		</joint>
		<joint name="nodding_to_laser" type="fixed">
			<parent link="nodding_link"/>
			<child link="laser"/>
			<origin xyz="0 0 0.0325" rpy="0 0 0"/>
		</joint>
	</xacro:if>
</robot>
