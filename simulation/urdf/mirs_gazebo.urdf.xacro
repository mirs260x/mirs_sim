<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mirs260x_gazebo">
	<xacro:include filename="mirs.urdf.xacro"/>

	<!--==============================================================
		Gazebo用の摩擦係数の設定
	==============================================================-->
	<xacro:macro name="wheel" params="prefix">
		<gazebo reference="${prefix}_wheel">
			<mu1>0.8</mu1>
			<mu2>0.8</mu2>
			<kp>1000000.0</kp>
			<kd>10.0</kd>
			<minDepth>0.001</minDepth>
			<maxVel>1.0</maxVel>
		</gazebo>
	</xacro:macro>

	<xacro:wheel prefix="left_1"/>
	<xacro:wheel prefix="left_2"/>
	<xacro:wheel prefix="left_3"/>
	<xacro:wheel prefix="left_4"/>
	<xacro:wheel prefix="right_1"/>
	<xacro:wheel prefix="right_2"/>
	<xacro:wheel prefix="right_3"/>
	<xacro:wheel prefix="right_4"/>

	<!--==============================================================
		Gazeboプラグイン
	==============================================================-->
	<gazebo>
		<!-- Diff Drive controller -->
		<plugin
			filename="gz-sim-diff-drive-system"
			name="gz::sim::systems::DiffDrive">
			<left_joint>left_1_wheel_joint</left_joint>
			<left_joint>left_2_wheel_joint</left_joint>
			<left_joint>left_3_wheel_joint</left_joint>
			<left_joint>left_4_wheel_joint</left_joint>
			<right_joint>right_1_wheel_joint</right_joint>
			<right_joint>right_2_wheel_joint</right_joint>
			<right_joint>right_3_wheel_joint</right_joint>
			<right_joint>right_4_wheel_joint</right_joint>
			<wheel_separation>0.465</wheel_separation>
			<wheel_radius>0.0665</wheel_radius>
			<odom_publish_frequency>30</odom_publish_frequency>
			<topic>cmd_vel</topic>
			<odom_topic>odom</odom_topic>
			<tf_topic>tf</tf_topic>
			<frame_id>odom</frame_id>
			<child_frame_id>base_footprint</child_frame_id>
		</plugin>

		<!-- Joint State Publisher -->
		<plugin
			filename="gz-sim-joint-state-publisher-system"
			name="gz::sim::systems::JointStatePublisher">
			<joint_name>left_1_wheel_joint</joint_name>
			<joint_name>left_2_wheel_joint</joint_name>
			<joint_name>left_3_wheel_joint</joint_name>
			<joint_name>left_4_wheel_joint</joint_name>
			<joint_name>right_1_wheel_joint</joint_name>
			<joint_name>right_2_wheel_joint</joint_name>
			<joint_name>right_3_wheel_joint</joint_name>
			<joint_name>right_4_wheel_joint</joint_name>
			<topic>joint_states</topic>
			<update_rate>30</update_rate>
		</plugin>

		<!-- Sensor system (LIDAR) -->
		<plugin
			filename="gz-sim-sensors-system"
			name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>
	</gazebo>

	<!--==============================================================
		LIDARプラグイン設定
	==============================================================-->
	<gazebo reference="laser">
		<sensor type="gpu_lidar" name="laser">
			<pose>0 0 0 0 0 0</pose>
			<visualize>true</visualize>
			<update_rate>10</update_rate>
			<ray>
				<scan>
					<horizontal>
						<samples>360</samples>
						<resolution>1</resolution>
						<min_angle>-3.141592</min_angle>
						<max_angle>3.141592</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.15</min>
					<max>12.0</max>
					<resolution>0.01</resolution>
				</range>
			</ray>
			<topic>scan</topic>
			<!-- Gazebo Harmonicはモデル名プレフィックスを自動付与するため、
			     gz_frame_idでURDFのリンク名を明示指定してTFの一致を保証する -->
			<gz_frame_id>laser</gz_frame_id>
		</sensor>
	</gazebo>

	<!--==============================================================
		RealSense D435 シミュレーション
		- camera_color_frame : RGBカメラ (640x480, 30Hz)
		- camera_depth_frame : Depthカメラ (640x480, 30Hz, 最大10m)
	==============================================================-->

	<!-- RGB カメラ -->
	<gazebo reference="camera_color_frame">
		<sensor type="camera" name="camera_color">
			<pose>0 0 0 0 0 0</pose>
			<visualize>false</visualize>
			<update_rate>30</update_rate>
			<camera>
				<!-- D435 RGB FoV: 69.4° H -->
				<horizontal_fov>1.2112</horizontal_fov>
				<image>
					<width>640</width>
					<height>480</height>
					<format>R8G8B8</format>
				</image>
				<clip>
					<near>0.1</near>
					<far>30</far>
				</clip>
			</camera>
			<topic>camera/color/image_raw</topic>
			<camera_info_topic>camera/color/camera_info</camera_info_topic>
			<!-- gz_frame_idを光学フレーム(optical_frame)に指定して正しく座標変換を適用 -->
			<gz_frame_id>camera_color_optical_frame</gz_frame_id>
		</sensor>
	</gazebo>

	<!-- Depth カメラ (RealSense D435 相当) -->
	<gazebo reference="camera_depth_frame">
		<sensor type="depth_camera" name="camera_depth">
			<pose>0 0 0 0 0 0</pose>
			<visualize>false</visualize>
			<update_rate>30</update_rate>
			<camera>
				<!-- D435 Depth FoV: 87° H -->
				<horizontal_fov>1.5184</horizontal_fov>
				<image>
					<width>640</width>
					<height>480</height>
				</image>
				<clip>
					<!-- D435 depth range: 0.1m - 10m -->
					<near>0.1</near>
					<far>10.0</far>
				</clip>
			</camera>
			<topic>camera/depth/image_raw</topic>
			<camera_info_topic>camera/depth/camera_info</camera_info_topic>
			<!-- gz_frame_idを光学フレーム(optical_frame)に指定して正しく座標変換を適用 -->
			<gz_frame_id>camera_depth_optical_frame</gz_frame_id>
		</sensor>
	</gazebo>
</robot>
