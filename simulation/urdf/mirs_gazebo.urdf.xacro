<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mirs260x_gazebo">
	<xacro:include filename="mirs.urdf.xacro"/>

	<!--==============================================================
		Gazebo用の摩擦係数の設定
	==============================================================-->
	<xacro:macro name="wheel_friction" params="prefix">
		<gazebo reference="${prefix}_wheel">
			<mu1>${wheel_mu_longitudinal}</mu1>
			<mu2>${wheel_mu_lateral}</mu2>
			<fdir1>1 0 0</fdir1>
			<kp>1000000.0</kp>
			<kd>10.0</kd>
			<minDepth>0.001</minDepth>
			<maxVel>1.0</maxVel>
		</gazebo>
	</xacro:macro>

	<xacro:wheel_friction prefix="left"/>
	<xacro:wheel_friction prefix="right"/>
	<gazebo reference="front_caster">
		<mu1>${caster_mu}</mu1>
		<mu2>${caster_mu}</mu2>
	</gazebo>
	<gazebo reference="rear_caster">
		<mu1>${caster_mu}</mu1>
		<mu2>${caster_mu}</mu2>
	</gazebo>

	<!--==============================================================
		Gazeboプラグイン
	==============================================================-->
	<gazebo>
		<!-- Diff Drive controller -->
		<plugin
			filename="gz-sim-diff-drive-system"
			name="gz::sim::systems::DiffDrive">
			<left_joint>left_wheel_joint</left_joint>
			<right_joint>right_wheel_joint</right_joint>
			<wheel_separation>${wheel_track}</wheel_separation>
			<wheel_radius>${wheel_radius}</wheel_radius>
			<!-- Bound braking torque from abrupt /cmd_vel changes. -->
			<max_linear_acceleration>0.5</max_linear_acceleration>
			<min_linear_acceleration>-0.5</min_linear_acceleration>
			<max_angular_acceleration>1.0</max_angular_acceleration>
			<min_angular_acceleration>-1.0</min_angular_acceleration>
			<odom_publish_frequency>30</odom_publish_frequency>
			<topic>cmd_vel</topic>
			<odom_topic>odom</odom_topic>
			<tf_topic>tf</tf_topic>
			<frame_id>odom</frame_id>
			<child_frame_id>base_footprint</child_frame_id>
		</plugin>

		<!-- Joint State Publisher -->
		<plugin
			filename="gz-sim-joint-state-publisher-system"
			name="gz::sim::systems::JointStatePublisher">
			<joint_name>left_wheel_joint</joint_name>
			<joint_name>right_wheel_joint</joint_name>
			<xacro:if value="$(arg nodding)">
				<joint_name>nodding_joint</joint_name>
			</xacro:if>
			<topic>joint_states</topic>
			<update_rate>30</update_rate>
		</plugin>
		<xacro:if value="$(arg nodding)">
			<plugin filename="gz-sim-joint-position-controller-system"
				name="gz::sim::systems::JointPositionController">
				<joint_name>nodding_joint</joint_name>
				<topic>/nodding_cmd</topic>
				<p_gain>20</p_gain>
				<d_gain>1</d_gain>
				<cmd_max>10</cmd_max>
				<cmd_min>-10</cmd_min>
				<initial_position>-0.349066</initial_position>
			</plugin>
		</xacro:if>

		<!-- Sensor system (LIDAR) -->
		<plugin
			filename="gz-sim-sensors-system"
			name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>
	</gazebo>

	<!--==============================================================
		LIDARプラグイン設定
	==============================================================-->
	<gazebo reference="laser">
		<sensor type="gpu_lidar" name="laser">
			<pose>0 0 0 0 0 0</pose>
			<visualize>true</visualize>
			<!-- RPLIDAR S1 DenseBoost numerical specs: SLAMTEC datasheet rev. 1.7; URL in README.md. -->
			<update_rate>10</update_rate>
			<ray>
				<scan>
					<horizontal>
						<samples>920</samples>
						<resolution>1</resolution>
						<min_angle>-3.141592</min_angle>
						<max_angle>3.141592</max_angle>
					</horizontal>
					<vertical>
						<samples>1</samples>
						<min_angle>0</min_angle>
						<max_angle>0</max_angle>
					</vertical>
				</scan>
				<range>
					<min>0.1</min>
					<max>40.0</max>
					<resolution>0.03</resolution>
				</range>
			</ray>
			<topic>scan</topic>
			<!-- Gazebo Harmonicはモデル名プレフィックスを自動付与するため、
			     gz_frame_idでURDFのリンク名を明示指定してTFの一致を保証する -->
			<gz_frame_id>laser</gz_frame_id>
		</sensor>
	</gazebo>
	<gazebo reference="imu_link">
		<sensor name="imu" type="imu">
			<always_on>true</always_on>
			<update_rate>100</update_rate>
			<topic>imu/data_raw</topic>
			<gz_frame_id>imu_link</gz_frame_id>
		</sensor>
		<sensor name="magnetometer" type="magnetometer">
			<always_on>true</always_on>
			<update_rate>17</update_rate>
			<topic>imu/mag</topic>
			<gz_frame_id>imu_link</gz_frame_id>
		</sensor>
	</gazebo>
</robot>
