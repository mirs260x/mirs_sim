		<model name="slide">
			<static>true</static>
			<pose>-8 7 0 0 0.5 0.785</pose>
			<link name="link">
				<collision name="col">
					<pose>0 0 0.8 0 0 0</pose>
					<geometry><box><size>2.0 0.5 0.1</size></box></geometry>
				</collision>
				<visual name="vis">
					<pose>0 0 0.8 0 0 0</pose>
					<geometry><box><size>2.0 0.5 0.1</size></box></geometry>
					<material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
				</visual>
			</link>
		</model>

		<!-- Rocks and Trash can -->
		<model name="rock_1">
			<static>true</static>
			<pose>1 6 0.2 0.1 0.2 0.3</pose>
			<link name="link">
				<collision name="col">
					<geometry><sphere><radius>0.4</radius></sphere></geometry>
				</collision>
				<visual name="vis">
					<geometry><sphere><radius>0.4</radius></sphere></geometry>
					<material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
				</visual>
			</link>
		</model>

		<model name="rock_2">
			<static>true</static>
			<pose>-6 -6 0.15 -0.1 0.4 0</pose>
			<link name="link">
				<collision name="col">
					<geometry><sphere><radius>0.3</radius></sphere></geometry>
				</collision>
				<visual name="vis">
					<geometry><sphere><radius>0.3</radius></sphere></geometry>
					<material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
				</visual>
			</link>
		</model>

		<model name="trash_can">
			<static>true</static>
			<pose>-2 2 0.4 0 0 0</pose>
			<link name="link">
				<collision name="col">
					<geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
				</collision>
				<visual name="vis">
					<geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
					<material><ambient>0.1 0.3 0.2 1</ambient><diffuse>0.1 0.3 0.2 1</diffuse></material>
				</visual>
			</link>
		</model>
	</world>
</sdf>
