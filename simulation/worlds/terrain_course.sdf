<?xml version="1.0"?>
<sdf version="1.10">
  <world name="terrain_course">
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="surface">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="surface">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.3 0.4 0.3 1</ambient><diffuse>0.3 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- y=3: 4 m uphill, 2 m plateau, 4 m downhill.
         Each ramp rises 0.4 m over 4 m (about 5.7 degrees).
         The box center is below its top face so the low end meets z=0. -->
    <model name="ramp_course">
      <static>true</static>
      <link name="uphill">
        <pose>4 3 0.15025 0 -0.099669 0</pose>
        <collision name="collision">
          <geometry><box><size>4.01995 2.5 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.01995 2.5 0.1</size></box></geometry>
          <material><ambient>0.55 0.43 0.29 1</ambient><diffuse>0.55 0.43 0.29 1</diffuse></material>
        </visual>
      </link>
      <link name="plateau">
        <pose>7 3 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2 2.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 2.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.43 0.29 1</ambient><diffuse>0.55 0.43 0.29 1</diffuse></material>
        </visual>
      </link>
      <link name="downhill">
        <pose>10 3 0.15025 0 0.099669 0</pose>
        <collision name="collision">
          <geometry><box><size>4.01995 2.5 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.01995 2.5 0.1</size></box></geometry>
          <material><ambient>0.55 0.43 0.29 1</ambient><diffuse>0.55 0.43 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- y=-3: five 3 cm height changes, then back to ground. -->
    <model name="step_course">
      <static>true</static>
      <link name="step_03_up">
        <pose>3 -3 0.015 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 2.5 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2.5 0.03</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name="step_06_up">
        <pose>4 -3 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 2.5 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2.5 0.06</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name="step_09">
        <pose>5 -3 0.045 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 2.5 0.09</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2.5 0.09</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name="step_06_down">
        <pose>6 -3 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 2.5 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2.5 0.06</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name="step_03_down">
        <pose>7 -3 0.015 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 2.5 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2.5 0.03</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tall fixed objects provide recognizable geometry for mapping. -->
    <model name="landmark_left">
      <static>true</static>
      <pose>-3 5 0.75 0 0 0</pose>
      <link name="post">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.8 0.25 0.2 1</ambient><diffuse>0.8 0.25 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="landmark_right">
      <static>true</static>
      <pose>-3 -5 0.75 0 0 0</pose>
      <link name="post">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
