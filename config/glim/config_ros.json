{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "ang_scale": 1.0,
    "imu_frame_id": "glim_base",
    "lidar_frame_id": "glim_base",
    "base_frame_id": "glim_base",
    "odom_frame_id": "glim_odom",
    "map_frame_id": "glim_map",
    "publish_imu2lidar": false,
    "tf_time_offset": 0.0,
    "extension_modules": [
      "librviz_viewer.so"
    ],
    "imu_topic": "/imu/data_raw",
    "points_topic": "/glim/input_points",
    "image_topic": "/image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data",
      "depth": 20
    }
  }
}
